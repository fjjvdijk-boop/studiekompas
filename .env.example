# Kopieer dit bestand naar .env.local (lokaal) of zet de waarden in Vercel → Settings → Environment Variables.
# Zonder deze waarden werkt de app ook: dan wordt alles in de browser bewaard.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen voor de e-mailherinnering (nooit in de browser gebruiken!)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Een lange willekeurige tekst; Vercel stuurt hem mee bij de dagelijkse taak
CRON_SECRET=
# Afzender, bijvoorbeeld: StudieKompas <herinnering@jouwdomein.nl>
MAIL_VAN=
